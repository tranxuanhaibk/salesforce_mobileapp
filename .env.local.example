# =============================================================================
# .env.local.example — Local Development Environment Variables Template
# Copy this file to `.env.local` and fill in your real credentials:
#   cp .env.local.example .env.local
# =============================================================================

# 1. SERVER-ONLY SECRETS
SALESFORCE_CLIENT_ID="your_salesforce_connected_app_consumer_key"
SALESFORCE_CLIENT_SECRET="your_salesforce_connected_app_consumer_secret"
SALESFORCE_REDIRECT_URI="http://localhost:3000/api/auth/callback/salesforce"
SALESFORCE_LOGIN_URL="https://login.salesforce.com"
SALESFORCE_API_VERSION="v60.0"

# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY="replace_with_64_character_hex_string_generated_via_crypto_random"

SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_secret_key"

# 2. PUBLIC CLIENT VARIABLES
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_public_anon_key"
